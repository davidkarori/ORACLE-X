# ORACLE X environment template
#
# Copy this file to .env for local development.
# Never commit real credentials.

# Application
APP_ENV=development
APP_NAME=ORACLE_X
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=info

# Trading mode
# Default to paper trading. Live trading must require explicit configuration.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
KILL_SWITCH_ACTIVE=false

# Supabase / PostgreSQL
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Featherless inference
FEATHERLESS_BASE_URL=
FEATHERLESS_API_KEY=
FEATHERLESS_DEFAULT_MODEL=
FEATHERLESS_ATHENA_MODEL=
FEATHERLESS_HADES_MODEL=
FEATHERLESS_HERMES_MODEL=
FEATHERLESS_MORPHEUS_MODEL=
FEATHERLESS_REQUEST_TIMEOUT_MS=30000
FEATHERLESS_MAX_RETRIES=2

# Alpaca paper trading
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Alpaca live trading
# Leave empty unless live trading has been explicitly approved.
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Market data
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_MS=15000

# Risk Governor defaults
MAX_DAILY_LOSS=
MAX_TRADE_LOSS=
MAX_PORTFOLIO_EXPOSURE=
MAX_SYMBOL_CONCENTRATION=
MAX_OPEN_POSITIONS=
RISK_APPROVAL_TTL_SECONDS=300

# Execution Guard defaults
ORDER_IDEMPOTENCY_NAMESPACE=oracle-x
MAX_MARKET_DATA_AGE_SECONDS=60
ALLOW_EXTENDED_HOURS=false

# MCP / tool integrations
ALPACA_MCP_ENABLED=false
ALPACA_MCP_READ_ONLY=true

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=oracle-x
